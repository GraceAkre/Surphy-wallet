# ==============================================================================
# Surphy Wallet — Variables d'Environnement
# ==============================================================================
# Copier ce fichier en .env.local et remplir les valeurs
# IMPORTANT : Ne JAMAIS commiter .env.local
# ==============================================================================

# --- SUPABASE (obligatoire) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- APPLICATION ---
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- SECURITE ---
JWT_SECRET=changeme            # openssl rand -hex 32
ALLOWED_CAMPUSES=Paris,Lyon,Bordeaux

# --- SEUILS ML (optionnel, defauts dans le code) ---
THRESHOLD_AMOUNT_HIGH=2500
THRESHOLD_SCA_DAILY=750
THRESHOLD_VELOCITY_COUNT=3
THRESHOLD_DUPLICATE_WINDOW=2
THRESHOLD_NIGHT_START=0
THRESHOLD_NIGHT_END=6

# --- PERFORMANCE ---
ML_TIMEOUT_MS=100
DB_POOL_SIZE=10
